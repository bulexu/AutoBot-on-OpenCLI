{
  "name": "autobot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc",
    "lint": "eslint src test examples",
    "format": "prettier --write src test examples",
    "format:check": "prettier --check src test examples",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "desktop": "electron .",
    "package:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@jackwener/opencli": "2.0.3",
    "@langchain/core": "1.3.7",
    "@langchain/langgraph": "1.7.3",
    "@langchain/openai": "1.8.3",
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "version": "0.1.0",
  "main": "src/desktop/main.ts"
}
