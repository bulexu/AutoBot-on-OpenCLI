{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/desktop/renderer/*"]
    }
  },
  "include": ["src/desktop/renderer/**/*.ts", "src/desktop/renderer/**/*.vue"]
}
